# ==============================================================================
#  WSL2 全局配置
#
#  作用范围：所有发行版共享的同一个虚拟机（不是每个发行版一份）
#            主机 31.2 GB 内存 / 24 逻辑核心
#  生效方式：修改后执行  wsl --shutdown  （会关掉全部发行版和 Docker）
#  层级区分：本文件 = 全局；/etc/wsl.conf = 单个发行版
# ==============================================================================

[wsl2]

# ------------------------------------------------------------------ 网络
# 以下三项是你原有的设置，保持不变
networkingMode=mirrored
dnsTunneling=true
autoProxy=true

# 【未启用，需要时手动取消注释】
# mirrored 模式下 WSL 与主机共用网络栈，WSL 里监听的服务会直接暴露在局域网上。
# firewall=true 让 Windows 防火墙规则覆盖 WSL 流量。
# 但 mirrored + 系统代理 + Docker Desktop 本身已是上游已知的问题组合，
# 再叠一层防火墙会让排障变复杂，所以先不启用。
# firewall=true


# ------------------------------------------------------------------ 资源上限
# 四个发行版 + Docker 抢的是下面这同一份资源，不是每份。
# 显式写死，避免以后加内存或换机器时行为悄悄漂移。

memory=16GB

# 默认是吃满全部 24 核。留 8 核给 Windows，否则全量编译时整机会卡到没法用。
processors=16

# 大小与当前默认值一致（4GB），只换位置。
# 默认路径在 C:\Users\琳珉琨珸\AppData\Local\Temp\swap.vhdx，而 C 盘只剩 10.6GB。
swap=4GB
swapFile=E:\\WSL\\swap.vhdx


# ------------------------------------------------------------------ 实验特性

[experimental]

# 页缓存用完后归还给 Windows。编译、Docker 构建跑完之后不再长期占着内存。
# 取值：gradual（渐进回收）/ dropcache（立即丢弃）/ disabled
autoMemoryReclaim=gradual

# 【不要设置 sparseVhd=true】
# WSL 2.7.13 已全局禁用稀疏 VHD。实测报错原文：
#   "由于潜在的数据损坏，目前已禁用稀疏 VHD 支持。"
# 亦即该开关在当前版本不生效；而强制启用需要 --allow-unsafe，
# 官方明确写出「潜在的数据损坏」，不要用。
# 回收 vhdx 空间改用：wsl --shutdown 后以 diskpart 的 compact vdisk 手动压缩。

# mirrored 模式下允许 WSL 访问宿主机的其它 IP（不只回环地址）。
hostAddressLoopback=true
